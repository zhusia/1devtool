    },
    "semanticTokenColors": {
        "enumMember": "#098658",
        "property": "#001080",
        "variable.defaultLibrary": "#267F99"
    },
    "tokenColors": [
        {
            "name": "Types",
            "scope": [
                "entity.name.type",
                "entity.other.inherited-class",
                "keyword.other.type",
                "punctuation.definition.annotation",
                "storage.modifier.import",
                "storage.modifier.package",
                "storage.type.annotation",
                "storage.type.built-in",
                "storage.type.generic",
                "storage.type.java",
                "storage.type.groovy",
                "storage.type.primitive",
                "support.class",
                "support.other.namespace",
                "support.type",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#267F99"
            }
        },
        {
            "name": "Tags / Properties",
            "scope": [
                "constant.other.character-class",
                "entity.name.tag",
                "heading",
                "meta.object-literal.key",
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.list.end.markdown",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "support.type.property-name",
                "variable.object.property",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#800000"
            }
        },
        {
            "name": "Escape / Regex / Links",
            "scope": [
                "constant.character.escape",
                "keyword.operator",
                "markup.underline.link",
                "string.regexp",
                "string.url"
            ],
            "settings": {
                "foreground": "#811F3F"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "entity.other.attribute-name.id.css",
                "meta.function-call.generic",
                "string.other.link",
                "support.function",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#795E26"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "meta.brace",
                "punctuation.accessor",
                "punctuation.definition.block",
                "punctuation.separator",
                "support.type.property-name.css"
            ],
            "settings": {
                "foreground": "#000000"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "markup.inline",
                "markup.quote",
                "source.ini",
                "string.other.link.description",
                "string"
            ],
            "settings": {
                "foreground": "#A31515"
            }
        },
        {
            "name": "Comments",
            "scope": ["comment"],
            "settings": {
                "foreground": "#008000"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword.operator.new",
                "keyword",
                "markup.italic",
                "punctuation.definition.block.tag",
                "storage.modifier",
                "storage.type"
            ],
            "settings": {
                "foreground": "#0000FF"
            }
        },
        {
            "name": "Constants / Parameters",
            "scope": [
                "constant",
                "entity.other.attribute-name",
                "keyword.operator.quantifier.regexp",
                "markup.bold",
                "support.constant",
                "variable.other.constant",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#098658"
            }
        },
        {
            "name": "Always italic",
            "scope": ["markup.quote", "markup.italic"],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "Always bold",
            "scope": ["heading", "markup.bold"],
            "settings": {
                "fontStyle": "bold"
            }
        }
    ]
}
